<?xml version="1.0"?>
<package format="3">
  <name>astrall_sensor_bridge</name>
  <version>0.1.0</version>
  <description>Bridge Astrall SDK IMU, planar odometry, and H.264 camera stream to ROS 2.</description>
  <maintainer email="maintainer@example.com">Astrall workspace maintainer</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <build_depend>pkg-config</build_depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
